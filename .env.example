# クラウド連携・LINE(LIFF)の設定サンプル。
# このファイルを .env という名前でコピーし、値を自分のものに置き換える。
# （.env は Git にコミットしないこと）

# LIFF ID（LINE Developers で LIFF を追加すると発行される。例: 1234567890-abcdEfgh）
VITE_LIFF_ID=

# Google Apps Script ウェブアプリの URL（デプロイ時に発行される /exec で終わるURL）
VITE_GAS_URL=

# Apps Script 側の「スクリプト プロパティ API_TOKEN」と完全に同じ文字列
VITE_GAS_TOKEN=
